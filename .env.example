MODEL_API_KEY=
# Required for production follow-up database operations.
# Use the Supabase Session Pooler connection string: the server sets
# `prepare: true`, which needs session-mode pooling.
DATABASE_URL=
# Reserved for a separate test database. Must never point at production/demo data.
TEST_DATABASE_URL=
# Optional. Only for local PostgreSQL integration testing.
# SSL remains required by default. Set to `disable` to allow a loopback
# TEST_DATABASE_URL without SSL. Must never be used to disable SSL for a
# remote or production database.
TEST_DATABASE_SSL=disable
# Optional. Defaults to 3001 when unset.
PORT=
# Follow-up CRUD routes (/api/followups) stay disabled unless this is exactly
# 'true'. Keep it unset or 'false' for the public demo: the shipped frontend
# does not use these endpoints. Disabled requests get a generic 404 without
# touching the database. Tests enable the routes per-app instead of via env.
ENABLE_FOLLOWUPS=false
# Note: the database connection is lazy — it is only opened on first use.
